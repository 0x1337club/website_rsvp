# Copy to .env for local use. On Vercel, set these in Project Settings -> Environment Variables.

# sha256 of the admin password. Generate with: python3 app.py set-password
ADMIN_PASSWORD_HASH=

# Postgres connection string (set automatically on Vercel when you connect a Neon/Postgres database).
# Leave unset locally to use the SQLite file rsvp.db.
DATABASE_URL=

# Public site URL used in team links, e.g. https://your-project.vercel.app
RSVP_BASE_URL=

# Event name shown on the pages
RSVP_EVENT=ContextCon Deccan CTF
